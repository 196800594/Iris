{
  "name": "iris-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Iris 即时通讯桌面客户端（Tauri 2 + React + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "proto": "pbjs --target static-module --wrap es6 --out src/types/iris.js ../server/crates/im-proto/proto/iris.proto && pbts --out src/types/iris.d.ts src/types/iris.js",
    "icons": "tauri icon assets/icon-source.png"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "@tauri-apps/plugin-sql": "^2.2.0",
    "long": "^5.2.3",
    "protobufjs": "^7.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "protobufjs-cli": "^1.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "protobufjs"
    ]
  }
}
