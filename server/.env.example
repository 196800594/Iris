# =====================================================================
# Iris 服务端环境变量示例文件
# 用法：复制为同目录 .env 后按需修改
#   cp .env.example .env        （PowerShell: Copy-Item .env.example .env）
# 说明：
#   - 本文件可以安全入库；.env 含真实秘密，已被 .gitignore 忽略，禁止提交
#   - 用 docker compose 跑全栈时，容器内的主机名/URL 由 compose 文件
#     的 environment 段自动覆盖（mysql / redis / logic 服务名），无需手改
# =====================================================================

# ---------------- 基础运行 ----------------
# 运行环境：development（开发：CORS 放开、验证码打日志）/ production（生产：严格校验）
APP_ENV=development
# 日志级别（tracing 过滤语法）：排查协议可用 im_gateway=debug,info
RUST_LOG=info
# 日志格式：text（本机可读）/ json（生产采集）
LOG_FORMAT=text
# 时区
TZ=Asia/Shanghai

# ---------------- 监听地址 ----------------
# im-logic REST 监听
LOGIC_HTTP_ADDR=0.0.0.0:7200
# im-logic gRPC 监听（供 gateway 回连）
LOGIC_GRPC_ADDR=0.0.0.0:7201
# im-gateway WebSocket 监听
GATEWAY_WS_ADDR=0.0.0.0:7100
# gateway 回连 logic 的 gRPC 地址
# 本机 cargo 开发用 http://127.0.0.1:7201；容器内由 compose 覆盖为 http://logic:7201
LOGIC_GRPC_ENDPOINT=http://127.0.0.1:7201
# 网关节点唯一标识；多实例必须互不相同，留空则自动取主机名
GATEWAY_NODE_ID=
# logic 节点标识（sonyflake 雪花 machine-id 来源）；
# 留空取主机名哈希，同一台机器跑多个 logic 实例时必须显式区分
LOGIC_NODE_ID=
# 允许的跨域来源，逗号分隔；development 下用 *，production 必须收敛为白名单
CORS_ORIGINS=*

# ---------------- MySQL ----------------
# 以下四项供应用拼装连接串（本机开发连映射到宿主机的端口）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=iris
MYSQL_USER=iris
MYSQL_PASSWORD=changeme-strong-password
# 仅给 sqlx-cli 等本机工具使用；应用本身由上面四项拼装
DATABASE_URL=mysql://iris:changeme-strong-password@127.0.0.1:3306/iris
# 连接池上限
MYSQL_POOL_MAX=10
# compose 初始化 MySQL root 密码（仅 compose 插值使用，应用不读取）
MYSQL_ROOT_PASSWORD=changeme-root-password

# ---------------- Redis ----------------
# 本机开发连 127.0.0.1；容器内由 compose 覆盖为 redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------- JWT / 鉴权 ----------------
# JWT HS256 签名密钥：至少 32 字节
# 生产生成方式：openssl rand -hex 32（或 pwsh 生成随机 64 位十六进制）
JWT_SECRET=dev-only-please-change-to-random-32-bytes-minimum
# access 令牌有效期（秒），默认 2 小时
ACCESS_TOKEN_TTL_SECONDS=7200
# refresh 令牌有效期（秒），默认 30 天
REFRESH_TOKEN_TTL_SECONDS=2592000
# WebSocket 一次性 ticket 有效期（秒）
WS_TICKET_TTL_SECONDS=30

# ---------------- 邮件 SMTP ----------------
# 发信方式：im-logic 内置 lettre 0.11 异步 SMTP 客户端，直连第三方邮箱服务商，
#           不自建邮件服务器（不装 postfix/sendmail，不用 25 端口）
# false：开发模式，验证码只写入服务日志（不发邮件）
# true ：使用下面 SMTP 配置真实发信（生产必须）
SMTP_ENABLED=false
# 推荐服务商（在邮箱网页设置中开启 SMTP 服务后取用）：
#   QQ 邮箱：       smtp.qq.com
#   网易 163 邮箱： smtp.163.com
#   阿里云邮件推送：smtpdm.aliyun.com
SMTP_HOST=smtp.qq.com
# 465 = 隐式 TLS（推荐，云服务器与多数宽带封 25）；587 = STARTTLS（备选）
SMTP_PORT=465
# 登录账号：完整邮箱地址，如 yourname@qq.com
SMTP_USER=
# 登录密码：邮箱服务商生成的 SMTP“授权码”，不是邮箱登录密码
SMTP_PASSWORD=
# 发件人显示名与地址；邮箱一般要求与 SMTP_USER 同域/同账号
SMTP_FROM=Iris <yourname@qq.com>
# 邮箱验证码有效期（秒）
EMAIL_CODE_TTL_SECONDS=300
# 同一邮箱两次请求验证码的最小间隔（秒，Redis 冷却键）
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
# 开发兜底万能验证码：仅 APP_ENV=development 时生效（填了它，用户输此码直接通过，
# 不查 Redis、不发邮件）；production 强制忽略。留空=不启用
EMAIL_DEV_CODE=

# ---------------- 文件存储 ----------------
# 上传文件根目录；本机开发可改为 ./data/uploads，容器内为 /data/uploads
STORAGE_ROOT=./data/uploads
# 对外可访问的基础 URL，用于拼签名下载地址；生产填 https://你的域名
PUBLIC_BASE_URL=http://localhost:7200
# 文件签名 URL 的 HMAC 密钥（生产同样用随机 32 字节以上）
SIGNED_URL_SECRET=dev-only-sign-secret-please-change
# 签名 URL 有效期（秒）
SIGNED_URL_TTL_SECONDS=300
# 图片最大字节数（默认 20 MiB）
IMAGE_MAX_BYTES=20971520
# 其他文件最大字节数（默认 100 MiB）
FILE_MAX_BYTES=104857600

# ---------------- 连接与限流 ----------------
# WebSocket 静默超时（秒），超时无心跳则断开
WS_HEARTBEAT_TIMEOUT_SECONDS=90
# 单连接每分钟允许的上行帧数，超限断开
WS_RATE_LIMIT_PER_MINUTE=120
# 单条 WS 帧最大字节数（默认 1 MiB；文件上传走 HTTP multipart，不受此限）
WS_MAX_FRAME_BYTES=1048576
# 鉴权类接口每 IP 每分钟最大请求数（登录/发验证码）
AUTH_RATE_LIMIT_PER_MINUTE=10
