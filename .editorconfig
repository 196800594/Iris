# 统一编辑器行为（计划书 4.1）：行尾 LF、UTF-8、去尾空格、文末加空行
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Rust：4 空格缩进
[*.rs]
indent_style = space
indent_size = 4

# TypeScript / JavaScript / JSON：2 空格缩进
[*.{ts,tsx,js,jsx,json}]
indent_style = space
indent_size = 2

# SQL / YAML / Dockerfile / dotenv：2 空格缩进
[*.{sql,yml,yaml,conf}]
indent_style = space
indent_size = 2

[{Dockerfile,*.Dockerfile}]
indent_style = space
indent_size = 4
